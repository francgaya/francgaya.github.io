---
/**
 * The one layout. Header, page body, CTA, footer.
 *
 * The shared blocks live here and are written once, which is the whole reason
 * this site is generated rather than hand-written: the CTA, the footer, and
 * the menu exist in one file, not in ten.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CallToAction from '../components/CallToAction.astro';
import { alternateOf, type Locale, type Route } from '../i18n/routes';

interface Props {
  locale: Locale;
  /** 'none' is the 404, which is not a page of the site and has no twin. */
  current: Route['id'] | 'none';
  title: string;
  description: string;
  /** The UI kit is an internal working page. */
  noindex?: boolean;
  /** The kit renders its own CTA as a specimen instead. */
  showCta?: boolean;
  /** Where the language switcher points when there is no paired route. */
  alternate?: string;
}

const {
  locale,
  current,
  title,
  description,
  noindex = false,
  showCta = true,
  alternate: alternateProp,
} = Astro.props;

const CONTACT = {
  email: 'mail@francgaya.com',
  linkedin: 'linkedin.com/in/francgaya',
};

// Verbatim from web/content/{en,es}/_common.md.
//
// The Spanish CTA lead is NOT a word-for-word rendering of the English one:
// the source of record ends on "escríbeme", and the source of record wins.
// P-16 back-translated the English here, which is the exact failure the
// word-by-word transcription check exists to catch.
const COPY = {
  en: {
    ctaHeading: "Let's talk",
    ctaLead: 'If any of this is close to what you are building, I am easy to reach.',
    credit: 'Site built by Bits&Roses',
    skip: 'Skip to content',
  },
  es: {
    ctaHeading: '¿Hablamos?',
    ctaLead: 'Si algo de esto se parece a lo que estás construyendo, escríbeme.',
    credit: 'Web desarrollada por Bits&Roses',
    skip: 'Saltar al contenido',
  },
}[locale];

const alternate = current === 'none' ? (alternateProp ?? '/') : alternateOf(current, locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang has to be absolute to be honoured, unlike an in-page link.
const alternateUrl = new URL(alternate, Astro.site);

// One card per language, generated by scripts/og_image.py and committed. The
// link is pasted on LinkedIn far more often than it is typed, so this is the
// first thing most readers see of the site.
const ogImage = new URL(locale === 'en' ? '/og-en.png' : '/og-es.png', Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Canonical, hreflang, and the share card belong to pages that are meant to
      be found and shared. The two noindex pages, /ui-kit and the 404, are
      neither, and the 404 in particular would claim a canonical URL of /404/
      that nothing ever links to.
    */}
    {
      !noindex && (
        <Fragment>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang={locale === 'en' ? 'es' : 'en'} href={alternateUrl} />
          <link rel="alternate" hreflang={locale} href={canonical} />
          {/* x-default is what a reader gets when neither of the other two
              matches. English: it is the version at the root, and the one the
              LinkedIn audience lands on. */}
          <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : alternateUrl} />

          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Franc Gaya" />
          {/* en_US, not en_GB: the public material is American English with the
              Oxford comma, decided 2026-08-01. */}
          <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Franc Gaya, Embedded Systems Product Architect" />
          <meta name="twitter:card" content="summary_large_image" />
        </Fragment>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#133232" />
  </head>

  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-surface-deep focus:px-4 focus:py-2 focus:font-display focus:text-sm focus:font-semibold focus:text-ink-on-deep">
      {COPY.skip}
    </a>

    <SiteHeader locale={locale} current={current} alternate={alternate} />

    <main id="main">
      <slot />

      {
        showCta && (
          <CallToAction
            heading={COPY.ctaHeading}
            lead={COPY.ctaLead}
            email={CONTACT.email}
            linkedin={CONTACT.linkedin}
          />
        )
      }
    </main>

    <SiteFooter email={CONTACT.email} linkedin={CONTACT.linkedin} credit={COPY.credit} />

    {/*
      The only script on the site, and it is a progressive enhancement:
      the switcher already works without it, it just lands at the top of the
      equivalent page. This carries the reader's position across.

      Cheap because anchors are English in BOTH languages, which is a P-15b
      decision being cashed in here (adr-001-stack.md, section 6.4).

      is:inline on purpose: bundling it would emit a JavaScript file, and the
      verification counts emitted files. Eight lines in the head of the
      document are auditable; a hashed bundle is not.
    */}
    <script is:inline>
      (function () {
        function carryHash() {
          var hash = window.location.hash;
          document.querySelectorAll('[data-lang-switch]').forEach(function (link) {
            link.hash = hash ? hash.slice(1) : '';
          });
        }
        carryHash();
        window.addEventListener('hashchange', carryHash);
      })();
    </script>
  </body>
</html>
